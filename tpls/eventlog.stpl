<div class="statusTable">
	<div class="row align-items-center mb-2">
		<div class="col-lg-6 fw-bold">
			Event Log: today{if $days} and the last {$days} day{if $days > 1}s{/if}{/if} (<span id="eventlog_shown">{$entry_count}</span>/{$entry_count} entries)
			<div class="fw-normal" style="font-size: 75%;">Last updated: {$last_updated}</div>
		</div>
		<div class="col-lg-6">
			<form method="get" action="eventlog.php" class="row g-2 align-items-center justify-content-lg-end">
				<div class="col-auto">
					<label for="eventlog_days" class="col-form-label col-form-label-sm">Days back</label>
				</div>
				<div class="col-auto">
					<input id="eventlog_days" name="days" type="number" min="0" max="7" value="{$days}" class="form-control form-control-sm" style="width: 5rem;" />
				</div>
				<div class="col-auto">
					<div class="form-check">
						<input id="eventlog_oldest" name="oldestfirst" type="checkbox" value="1" class="form-check-input"{if $oldest_first} checked{/if} />
						<label for="eventlog_oldest" class="form-check-label">Older entries first</label>
					</div>
				</div>
				<div class="col-auto">
					<button type="submit" class="btn btn-sm btn-primary">Update</button>
				</div>
			</form>
		</div>
	</div>
	<div class="row mb-2">
		<div class="col-lg-3 ms-auto">
			<input id="eventlog_filter" class="form-control form-control-sm" type="search" placeholder="Filter" aria-label="Filter events" />
		</div>
	</div>
	{if $entry_count}
	<table id="eventlog_table" class="statusTable resp">
		<thead>
			<tr>
				<th class="status" style="min-width: 8em;">State</th>
				<th class="text-nowrap" style="min-width: 12em;">Time</th>
				<th style="min-width: 12em;">Type</th>
				<th class="hostname">Host</th>
				<th>Service</th>
				<th style="min-width: 40em;">Output</th>
			</tr>
		</thead>
		<tbody>
		{foreach $groups as $group}
			<tr class="event-group">
				<th colspan="6" class="text-center" style="background-color: #B8CCE4;">{$group.label}</th>
			</tr>
			{foreach $group.entries as $x}
			<tr class="event-row">
				<td class="status {$x.state|strtolower} text-center">{$x.state}</td>
				<td class="text-nowrap">{$x.time}</td>
				<td>{$x.type}</td>
				<td class="hostname"><a href="host_details.php?host_name={$x.host|urlencode}">{$x.host}</a></td>
				<td>{if $x.service}<a href="service_details.php?host_name={$x.host|urlencode}&amp;svc_name={$x.service|urlencode}">{$x.service}</a>{/if}</td>
				<td>{$x.text}</td>
			</tr>
			{/foreach}
		{/foreach}
		</tbody>
	</table>
	{else}
	<div class="text-center py-3">No events were logged for this period.</div>
	{/if}
	<hr />
	<div class="text-center" style="font-size: 75%;">
		<a href="{$core_cgi}showlog.cgi">Event Log in Nagios Core</a>
	</div>
</div>
